POSTGRES_DB=task_management
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_PORT=5432
SPRING_PROFILES_ACTIVE=dev,demo
REDIS_PORT=6379
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Required: generate a private Base64 key with `openssl rand -base64 32`.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=1h
# Public, local-only demo passwords. Never use the demo profile in production.
DEMO_USER_PASSWORD=local-demo-user-pass
DEMO_ADMIN_PASSWORD=local-demo-admin-pass

# Local-only broker credentials; use private credentials outside development.
NOTIFICATIONS_ENABLED=true
RABBITMQ_USER=task_app
RABBITMQ_PASSWORD=local-rabbit-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SMTP_LOCAL_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=notifications@taskmanagement.local
# Compose defaults SMTP_HOST to mailpit; Maven defaults to localhost.
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
